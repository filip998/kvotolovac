# KvotoLovac backend configuration
#
# Copy this file to .env before changing values:
#   cp .env.example .env

# SQLite database URL. Relative paths are resolved from the backend working directory.
DATABASE_URL=sqlite:///./kvotolovac.db

# Scheduler and logging.
SCRAPE_INTERVAL_MINUTES=10
SCRAPE_LOOKAHEAD_HOURS=24
LOG_LEVEL=INFO
CORS_ORIGINS=*

# Comma-separated bookmaker IDs enabled for scrape cycles.
BOOKMAKERS=mozzart,maxbet,oktagonbet,admiralbet,balkanbet,merkurxtip,pinnbet,soccerbet,superbet,betole,365,volcanobet

# Comma-separated sports enabled in the canonical offer pipeline.
ENABLED_SPORTS=basketball

# all = persist/analyze every supported market.
# player_props = skip outcome-offer lanes and persist/analyze only player_* thresholds.
# Basketball threshold scrapers may still fetch game rows as normalization/event context.
SCRAPE_MARKET_SCOPE=player_props

# Use "mock" for deterministic local development or "real" for live bookmaker HTTP calls.
SCRAPER_MODE=mock

# HTTP controls for real scraper mode. PROXY_LIST is comma-separated.
RATE_LIMIT_PER_SECOND=1.0
MERIDIAN_RATE_LIMIT_PER_SECOND=2.0
PROXY_LIST=

# Detail modes:
# partial = broad/list feeds only; full = extra per-match detail calls when supported.
SOCCERBET_DETAIL_MODE=partial
MERKURXTIP_DETAIL_MODE=partial

# Notification and retention settings.
NOTIFICATION_GAP_THRESHOLD=1.5
PERSIST_INAPP_NOTIFICATIONS=false
NOTIFICATION_RETENTION_DAYS=3
ODDS_HISTORY_RETENTION_DAYS=7
TEAM_REVIEW_RETENTION_DAYS=90

# Paths for generated operational artifacts and registries.
BENCHMARK_DIR=./benchmarks
LEAGUE_REGISTRY_PATH=./app/data/league_registry.json
TEAM_REGISTRY_PATH=./app/data/team_registry.json
